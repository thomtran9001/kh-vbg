config {
  type: "incremental",
  uniqueKey: ['task_form_id'],
  schema: "analytic_wework",
  bigquery: {
    partitionBy: "DATE(last_update)",
    labels: {
      workflow: "analytic_wework"
    }
  }
}

SELECT
  * EXCEPT(last_update)
  ,MAX(last_update) OVER (PARTITION BY task_form_id) as last_update
FROM ${ref('raw_task_form')}