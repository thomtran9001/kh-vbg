config {
  type: "table",
  uniqueKey: ['ticket_form_id'],
  schema: "analytic_service",
  bigquery: {
    labels: {
      workflow: "analytic_service"
    }
  }
}

SELECT
  * EXCEPT(last_update)
  ,MAX(last_update) OVER (PARTITION BY ticket_form_id) as last_update
FROM ${ref('raw_service_ticket_form')}